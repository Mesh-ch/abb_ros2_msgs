#-------------------------------------------------------------------------------
# Description:
#   The purpose of this service definition is to define a way to get the value
#   of a WObjData RAPID symbol defined in an ABB robot controller system.
#
# Note:
#   The WObjData is returned in a structured ROS message format, including user
#   frame and tool frame information.
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
# Service request fields
#-------------------------------------------------------------------------------
# Path to the targeted RAPID WObjData symbol.
abb_robot_msgs/RAPIDSymbolPath path

# Optional TF frame ids. If left empty, the service keeps its default naming:
# parent_frame_id -> "base_link"
# user_frame_id   -> ufmec if present, otherwise path.symbol
# object_frame_id -> <user_frame_id> + "_object"
string parent_frame_id
string user_frame_id
string object_frame_id

---

#-------------------------------------------------------------------------------
# Service response fields
#-------------------------------------------------------------------------------
# robot hold, Defines whether or not the robot in the actual program task is holding the work object:
bool robhold

# user frame programmed Data, Defines whether or not a fixed user coordinate system is used:
bool ufprog

# user frame mechanical unit
string ufmec

# User frame position (x, y, z).
float64[3] user_frame_position

# User frame orientation (quaternion x, y, z, w).
float64[4] user_frame_orientation

# Object frame position (x, y, z).
float64[3] object_frame_position

# Object frame orientation (quaternion x, y, z, w).
float64[4] object_frame_orientation

# Service success/failure indicator.
# Refer to 'abb_robot_msgs/ServiceResponses' for defined error codes.
uint16 result_code

# Status message (empty if service succeeded).
string message
